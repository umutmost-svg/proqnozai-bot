# Mini App API (miniapp/). Placeholders only — real values live in the
# deployment environment, never in git. Not read automatically: export them
# or pass them to the process.

# Same bot token the Telegram bot uses: needed to verify initData (HMAC).
MINIAPP_BOT_TOKEN=123456:replace-me
# Separate SQLite file of the Mini App (never the bot's bot.db).
MINIAPP_DB_PATH=/data/miniapp.db
# Comma-separated exact origins (scheme://host[:port]) allowed to call the API.
MINIAPP_TRUSTED_ORIGINS=https://miniapp.example.com
# production (Secure cookies, https origins) | development (loopback http only)
MINIAPP_ENV=production

# Optional (defaults shown)
MINIAPP_INIT_DATA_MAX_AGE_S=300
MINIAPP_INIT_DATA_FUTURE_SKEW_S=30
MINIAPP_SESSION_TTL_S=43200
MINIAPP_LOGIN_RATE_LIMIT=10
MINIAPP_LOGIN_RATE_WINDOW_S=60
MINIAPP_COOKIE_SAMESITE=lax
