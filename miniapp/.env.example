# Mini App API (miniapp/). Placeholders only — real values live in the
# deployment environment, never in git. Not read automatically: export them
# or pass them to the process.

# initData check: hmac (default; needs the bot token) | ed25519 (Telegram's public key; NO bot token).
MINIAPP_INITDATA_MODE=hmac
# hmac mode: the same bot token the Telegram bot uses. Must stay unset in ed25519 mode.
MINIAPP_BOT_TOKEN=123456:replace-me
# The bot's public numeric id (the token's prefix). Required for ed25519; in hmac mode it enables the
# auth.ed25519_shadow readiness measurement and must match the token.
MINIAPP_BOT_ID=123456
# production | test (Telegram test environment): which Telegram public key ed25519 uses.
MINIAPP_TELEGRAM_ENV=production
# CSRF key material (>= 32 printable chars). Required in ed25519 mode; otherwise derived from the token.
MINIAPP_CSRF_SECRET=replace-with-48-random-chars
# Closed launch: comma-separated Telegram user ids allowed to sign in (unset = everyone with a valid launch).
MINIAPP_ALLOWED_USER_IDS=
# Blocked Telegram user ids (comma-separated), e.g. carried over from the bot's admin block: no sign-in, sessions end.
MINIAPP_BLOCKED_USER_IDS=
# Separate SQLite file of the Mini App (never the bot's bot.db).
MINIAPP_DB_PATH=/data/miniapp.db
# Comma-separated exact origins (scheme://host[:port]) allowed to call the API.
MINIAPP_TRUSTED_ORIGINS=https://miniapp.example.com
# production (Secure cookies, https origins) | development (loopback http only)
MINIAPP_ENV=production

# Optional (defaults shown). Upper bounds: max age <= 3600, skew <= 300,
# session TTL <= 604800 (7 days); larger values stop the start.
MINIAPP_INIT_DATA_MAX_AGE_S=300
MINIAPP_INIT_DATA_FUTURE_SKEW_S=30
MINIAPP_SESSION_TTL_S=43200
# Logins with a valid signature per verified Telegram user per window.
# Per-IP limits belong to the edge proxy (docs/miniapp/auth.md).
MINIAPP_LOGIN_RATE_LIMIT=10
MINIAPP_LOGIN_RATE_WINDOW_S=60
MINIAPP_COOKIE_SAMESITE=lax
# Active sessions per user (1..5); a new login revokes the oldest beyond it.
MINIAPP_MAX_SESSIONS_PER_USER=5
# Emergency switch: false rejects NEW logins (503), existing sessions keep working.
MINIAPP_LOGINS_ENABLED=true
# Built frontend served on the same origin as /api (set in the stand image).
MINIAPP_STATIC_DIR=
# enforce | report-only (first runs in real Telegram clients)
MINIAPP_CSP_MODE=enforce
# Shared secret injected by the edge (Cloudflare Transform Rule) as X-Edge-Auth.
# Required when MINIAPP_ENV=production (start fails without it); empty only for
# loopback development. >= 32 random printable ASCII chars, set only in the stand
# host's secret settings (never in the repository).
MINIAPP_EDGE_SECRET=replace-with-48-random-chars
# Local docker experiments only: allow a database outside a mounted volume.
MINIAPP_ALLOW_EPHEMERAL_DB=false

# --- Odds pushed by the bot ------------------------------------------------
# Shared HMAC secret of the bot's odds export (the bot's MINIAPP_ODDS_FEED_SECRET).
# Empty: POST /api/internal/odds answers 404 and no odds are shown. >= 32 random
# printable ASCII chars, set only in the host's secret settings.
MINIAPP_ODDS_FEED_SECRET=
# Kill switch: false = signed pushes get 410 (the bot stops asking its source for prices)
# and no odds are shown anywhere. Default true.
MINIAPP_ODDS_FEED_ENABLED=true

# --- Sports data (M3) -------------------------------------------------------
# football-data.org key for the Mini App backend (its own variable, never in the frontend; it may hold the
# same key as the bot's FOOTBALL_KEY — then set MINIAPP_FOOTBALL_DATA_SHARED_RESERVE). Empty: "not connected".
MINIAPP_FOOTBALL_DATA_KEY=
# Competitions served (football-data.org codes; free plan: PL,PD,SA,BL1,FL1,CL,DED,PPL,ELC,BSA,EC,WC).
# Default: every free-plan club competition with a current season (EC, WC: add when they run).
MINIAPP_FOOTBALL_DATA_COMPETITIONS=PL,PD,SA,BL1,FL1,CL,ELC,DED,PPL,BSA
# true only on a paid plan with live scores; the free plan delays scores.
MINIAPP_FOOTBALL_DATA_LIVE_PLAN=false
# Self-imposed budgets under the provider's limits (free plan: 10 requests/minute).
MINIAPP_FOOTBALL_DATA_PER_MINUTE=8
MINIAPP_FOOTBALL_DATA_PER_DAY=3000
# Key shared with the bot: the provider's last N requests of every minute are left to the bot
# (the Mini App pauses until the provider's reset). 0 = the key is used by the Mini App alone.
MINIAPP_FOOTBALL_DATA_SHARED_RESERVE=0
# Upstream lookups per hour for event ids never seen in a listing.
MINIAPP_SPORTS_UNKNOWN_LOOKUPS_PER_HOUR=20

# --- AI analysis (M3.2) -----------------------------------------------------
# Anthropic key for the Mini App backend only (never the bot's ANTHROPIC_API_KEY,
# never in the frontend). Empty: the AI is reported "not connected", no model call.
MINIAPP_ANTHROPIC_API_KEY=
MINIAPP_AI_MODEL=claude-opus-5-5
# New analyses per Telegram user per UTC day (cached answers are free).
MINIAPP_AI_PER_USER_DAILY=10
# Model calls for the whole Mini App per UTC day (cost ceiling).
MINIAPP_AI_DAILY_BUDGET=200
