# Required
TELEGRAM_TOKEN=123456:replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me
ADMIN_ID=123456789
DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Optional
DASHBOARD_USER=admin
# On Railway this MUST point to a mounted volume, or bot.db is wiped on redeploy.
BOT_DB_DIR=.
WEBHOOK_URL=
PORT=8080
STATS_PORT=8888
BOT_API_URL=http://worker.railway.internal:8888
STATS_URL=http://worker.railway.internal:8888/stats

# Football data providers
# Preferred current-season historical data. FOOTBALL_KEY is preferred;
# FOOTBALL_API_KEY is accepted by config.py as a legacy fallback.
FOOTBALL_KEY=
FOOTBALL_API_KEY=

# api-football.com / api-sports.io for live fixtures and events.
APIFOOTBALL_KEY=

# Promo giveaway: users must be subscribed to this channel to claim a code.
# The bot MUST be an admin/member of it (for getChatMember). Leave empty to
# hide the promo button entirely. PROMO_CHANNEL is the getChatMember target
# ("@name" or a "-100…" id); PROMO_CHANNEL_URL is the public link for the
# "open channel" button (auto-derived from @name when omitted).
PROMO_CHANNEL=
PROMO_CHANNEL_URL=

# "Our partners" menu button — BOOTSTRAP ONLY. Partners now live in the
# database and are managed at /partners in the dashboard; this variable is
# imported ONCE, into an empty partners table, and ignored ever after. Editing
# it later changes nothing — edit the partner in the dashboard instead.
# Entries are "Name | https://url", separated by ';' (newlines also work where
# the host allows multi-line values; ';' is the portable form for .env files).
#   PARTNERS=Partner A | https://example.com/a;Partner B | https://example.com/b
PARTNERS=
# Legacy single-partner link, same bootstrap-only rule (used if PARTNERS is empty).
PARTNERS_URL=

# Public URL of the dashboard service. Set it to count partner clicks:
# buttons then point at <base>/r/<partner> which records the click and
# redirects on. LEAVE EMPTY unless the dashboard is reliably reachable —
# while it is set, a dashboard outage breaks partner links.
PARTNER_REDIRECT_BASE=
